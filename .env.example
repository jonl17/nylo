# Copy to .env.development / .env.production and fill in. Never commit real values.

# Prismic
PRISMIC_REPO_NAME=
PRISMIC_ACCESS_TOKEN=

# Mailchimp
MAILCHIMP_ENDPOINT=

# Algolia: browser search (GATSBY_ vars are inlined into the public JS bundle)
GATSBY_ALGOLIA_APP_ID=
GATSBY_ALGOLIA_INDEX_NAME=
# Search-only key (ACL: search). Safe to expose.
GATSBY_ALGOLIA_SEARCH_KEY=

# Algolia: indexing at build time (server-only, NO GATSBY_ prefix)
# Required for `gatsby build` when GATSBY_ALGOLIA_APP_ID is set; the build fails without it.
ALGOLIA_ADMIN_KEY=
# Set to true to build without indexing (e.g. deploy previews).
# ALGOLIA_SKIP_INDEXING=true
